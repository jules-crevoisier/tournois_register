# Database Configuration
# ======================
# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/tournois
# Docker: postgresql://postgres:postgres@db:5432/tournois
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tournois"

# NextAuth Configuration
# ======================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-minimum-32-characters"

# URL where the app is hosted
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Server URL (for API routes and redirects)
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Vercel Blob Storage (Optional for file uploads)
# ===============================================
# Create a Vercel Blob storage in your Vercel dashboard
# and copy the read/write token here
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxx"

# Paperclip Log Monitoring (Optional - Legacy)
# =============================================
# Endpoint for sending server-side error notifications
# PAPERCLIP_LOG_ENDPOINT="https://api.paperclip.ing/v1/logs"
# API key for authenticating with Paperclip logging service
# PAPERCLIP_LOG_API_KEY="your-paperclip-api-key"

# Sentry Error Monitoring
# =======================
# Create a Sentry project at https://sentry.io
# DSN is found in: Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxx.ingest.sentry.io/xxxxx"

# Required for source map uploads during build
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxx"

# Webhook secret for Sentry -> Paperclip integration
# Found in: Settings > Integrations > Internal Integration > Client Secret
# SENTRY_WEBHOOK_SECRET="your-webhook-client-secret"

# Paperclip Webhook Integration (for Sentry -> Paperclip issues)
# ==============================================================
# These are used by the Sentry webhook to create Paperclip issues
# PAPERCLIP_API_URL="https://api.paperclip.ing"
# PAPERCLIP_WEBHOOK_API_KEY="your-paperclip-api-key"
# PAPERCLIP_COMPANY_ID="your-company-id"
# PAPERCLIP_PROJECT_ID="your-project-id"
